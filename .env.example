# ╔═══════════════════════════════════════════════════╗
# ║           Yuki Bot — Environment Variables        ║
# ║  Copy this to .env and fill in your values        ║
# ╚═══════════════════════════════════════════════════╝

# ── Required ─────────────────────────────────────────
BOT_TOKEN=your_bot_token_here
OWNER_ID=your_telegram_user_id
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGO_DB_NAME=yukidb

# ── Optional but Recommended ─────────────────────────
OWNER_USERNAME=YourUsername
SUPPORT_LINK=https://t.me/YourSupportGroup
UPDATES_CHANNEL=https://t.me/YourChannel
LOG_GROUP_ID=your_log_group_id

# ── Telethon (for @all tagging) ───────────────────────
API_ID=your_api_id
API_HASH=your_api_hash
SESSION_STRING=your_telethon_session_string

# ── AI Chat (optional — enables smart replies) ────────
AI_API_KEY=sk-your-openai-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-3.5-turbo

# ── Images (Telegram file_id after first upload) ──────
START_IMAGE=https://telegra.ph/file/yuki-start.jpg
PING_IMAGE=https://telegra.ph/file/yuki-ping.jpg
OWNER_IMAGE=https://telegra.ph/file/yuki-owner.jpg

# ── Feature Flags ─────────────────────────────────────
AUTO_REVIVE_ENABLED=true
AUTO_REVIVE_MINUTES=30
MAX_STICKER_POOL=500

# ── Webhook (leave WEBHOOK=false for polling) ─────────
WEBHOOK=false
WEBHOOK_URL=https://your-domain.com
PORT=8443
